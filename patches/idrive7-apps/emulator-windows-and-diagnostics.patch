+const TASU = 'com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu';
+
+/**
+ * UDS over TASU (kit/runtime/diag.js) answered by a responder module, emu.js --diag <file>:
+ *   module.exports = (log) => ({ request(target, uds, reply) {} })
+ * uds is the request (service id first, as a Buffer); reply(ecu, bytes) sends one reply frame as the
+ * car's transport does (a 9-byte header with the unit's address in [6], then the UDS reply), once for
+ * each unit that answers (a functional 0xDF request may get several), later ones after a 7F xx 78.
+ * Every listener gets every frame, as on the car.
+ */
+function tasuStub(log, file) {
+    const responder = require(path.resolve(file))(log);
+    const listeners = [];
+    const reply = (ecu, bytes) => {
+        const frame = Buffer.concat([Buffer.from([0, 0, 0, 0, 0, 0, ecu & 0xFF, 0, 0]), Buffer.from(bytes)]);
+        setImmediate(() => listeners.forEach((fn) => { try { fn({ errorCode: 'NO_ERROR', udsResponse: frame }); } catch (e) { log.error('sendTasuResponse', e); } }));
+    };
+    log.info('emu: diagnostics answered by ' + path.basename(file));
+    return {
+        proxy: { iface: TASU, instance: 'SystemFunctionsInternalTasuInst1' },
+        listen: (fn) => { listeners.push(fn); },
+        request: (a) => {
+            const uds = Buffer.concat([Buffer.from([a.serviceID & 0xFF]), Buffer.from(a.udsData || [])]);
+            try { responder.request(a.targetAddress, uds, reply); } catch (e) { log.error('emu: diagnostics responder', e); }
+            return Promise.resolve('NO_ERROR');
+        },
+    };
+}
